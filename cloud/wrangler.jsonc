{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-bank-yudha",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "mini-bank", "database_id": "GANTI-DENGAN-DATABASE-ID"}]
}
